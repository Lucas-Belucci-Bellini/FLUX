# ---------------------------------------------------------------------------
# FLUX — environment template.
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Every variable is read exactly once, in `apps/web/src/env.ts`, which
# validates it at boot and fails loudly rather than handing `undefined`
# to the app. Do not read `process.env` anywhere else.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Public origin of the app; used for absolute URLs, cookies and CORS.
FLUX_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Persistence
#
# FLUX runs with an in-memory adapter when DATABASE_URL is unset, so
# `npm run dev` works on a clean machine with no services running.
# Set DATABASE_URL to switch every repository to PostgreSQL.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://flux:flux@localhost:5432/flux

# ---------------------------------------------------------------------------
# Sessions
#
# 32+ byte secret used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production; a fixed development value is used when unset.
# ---------------------------------------------------------------------------
# FLUX_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Not wired yet — listed so the shape of the system is visible.
# Each is introduced in the phase named in ROADMAP.md, never before it is used.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379          # phase 7: presence, rate limits, fan-out
# FLUX_MEDIA_BUCKET_URL=                    # phase 2: object storage for uploads
# FLUX_CDN_URL=                             # phase 12: asset delivery
